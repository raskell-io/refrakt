//// Live reload for `refrakt dev`.
////
//// `refrakt dev` runs a small Server-Sent Events server next to your app
//// (port 35729 by default) and tells the app about that port through the
//// `REFRAKT_LIVE_RELOAD_PORT` environment variable. After each successful
//// rebuild and restart, and after a change under `priv/`, it sends a
//// `reload` event, and the script below reloads the page.
////
//// The script is rendered only when `APP_ENV=dev` and
//// `REFRAKT_LIVE_RELOAD_PORT` holds a port number. With `APP_ENV=prod` or
//// `APP_ENV=test`, or when the app is started without `refrakt dev`,
//// `script()` renders nothing. The app itself never serves a reload
//// endpoint: the event stream lives in the `refrakt dev` process.
////
//// ## Usage
////
//// Put it at the end of the `<body>` in your root layout:
////
//// ```gleam
//// import refrakt/live_reload
////
//// body([], [main([class("container")], [inner]), live_reload.script()])
//// ```
////
//// Projects generated by `refrakt new` already do this in
//// `web/layouts/root_layout.gleam`.
////

import gleam/int
import gleam/result
import lustre/attribute
import lustre/element.{type Element}
import lustre/element/html

/// The live reload script, or nothing outside `refrakt dev`. Reads
/// `APP_ENV` and `REFRAKT_LIVE_RELOAD_PORT` each time it renders.
pub fn script() -> Element(message) {
  script_for(
    app_env: getenv("APP_ENV"),
    port: getenv("REFRAKT_LIVE_RELOAD_PORT"),
  )
}

/// `script` with the two environment variables passed in, for tests.
/// Renders the script only for `app_env: Ok("dev")` and a valid port.
pub fn script_for(
  app_env app_env: Result(String, Nil),
  port port: Result(String, Nil),
) -> Element(message) {
  case app_env, result.try(port, int.parse) {
    Ok("dev"), Ok(port) if port > 0 && port < 65_536 ->
      html.script([attribute.data("refrakt-live-reload", "")], source(port))
    _, _ -> element.none()
  }
}

/// Connects to the `refrakt dev` event stream on the page's host and
/// reloads on a `reload` event. EventSource reconnects by itself when
/// `refrakt dev` restarts.
fn source(port: Int) -> String {
  let url = "\"http://\" + location.hostname + \":" <> int.to_string(port)
  "(function () {
  var events = new EventSource(" <> url <> "/events\");
  events.addEventListener(\"reload\", function () { location.reload(); });
})();"
}

@external(erlang, "refrakt_live_reload_ffi", "getenv")
fn getenv(name: String) -> Result(String, Nil)
